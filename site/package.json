{
  "name": "plateforme-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.functions.json && vite build && node --experimental-strip-types scripts/prerendre.ts && node scripts/analytics-build.mjs",
    "test": "node scripts/test-unit.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:serve": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "check": "npm test && npm run build",
    "check:production": "node scripts/check-production.mjs",
    "test:edge": "node scripts/check-edge-routing.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
