{
  "name": "plateforme-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.functions.json && vite build && node --experimental-strip-types scripts/mandats-assets.ts && node --experimental-strip-types scripts/prerendre.ts && node --experimental-strip-types scripts/mandats-guides.ts && node --experimental-strip-types scripts/mandats-offline.ts",
    "test": "tsc -p tsconfig.type-tests.json --noEmit && node scripts/test-unit.mjs",
    "test:mobile390:server": "vite --mode test --host 127.0.0.1 --port 4175 --strictPort",
    "test:mobile390": "playwright test --config playwright.mobile390.config.ts",
    "preview": "vite preview",
    "test:mandats": "playwright test --config playwright.mandats.config.ts",
    "test:mandats:serve": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^5.9.0",
    "pmtiles": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
