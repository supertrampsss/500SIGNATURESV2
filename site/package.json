{
  "name": "plateforme-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/mandats-model-revisions.ts && vite",
    "build": "node --experimental-strip-types scripts/mandats-model-revisions.ts && tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.functions.json && vite build && node --experimental-strip-types scripts/mandats-assets.ts && node --experimental-strip-types scripts/prerendre.ts && node --experimental-strip-types scripts/mandats-guides.ts && node --experimental-strip-types scripts/mandats-offline.ts && node scripts/analytics-build.mjs",
    "test": "node scripts/test-unit.mjs",
    "preview": "vite preview",
    "test:board": "playwright test --config playwright.board.config.ts",
    "test:story": "playwright test --config playwright.story.config.ts",
    "test:mandats": "playwright test --config playwright.mandats.config.ts",
    "test:mandats:serve": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "check": "npm test && npm run build",
    "check:types": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.functions.json",
    "build:client": "node --experimental-strip-types scripts/mandats-model-revisions.ts && npm run check:types && vite build",
    "check:local": "npm test && npm run build:client",
    "business:case": "node --experimental-strip-types scripts/business-case.ts",
    "audit:visual": "playwright test --config playwright.visual.config.ts",
    "check:production": "node scripts/check-production.mjs",
    "test:edge": "node scripts/check-edge-routing.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "delaunator": "^5.1.0",
    "earcut": "^3.2.4",
    "maplibre-gl": "^5.9.0",
    "pmtiles": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/delaunator": "^5.0.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
